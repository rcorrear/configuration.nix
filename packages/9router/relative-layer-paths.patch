+// Layer member names are relative to the container root. Symlink targets
+// deliberately remain unchanged, including absolute /nix/store targets.
+func layerMemberName(path string) string {
+	name := strings.TrimLeft(path, "/")
+	if name == "" {
+		return "."
+	}
+	return name
+}
